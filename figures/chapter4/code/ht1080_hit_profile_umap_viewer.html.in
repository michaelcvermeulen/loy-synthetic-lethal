<!doctype html><html lang="en"><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>HT1080 candidate-profile UMAP</title>
<style>
@font-face{font-family:Open Sans;src:url(data:font/ttf;base64,FONT_PAYLOAD)}
*{box-sizing:border-box}body{margin:0;background:#f4f5f7;color:#252a34;font:14px 'Open Sans',Arial,sans-serif}header{padding:19px 25px 14px;background:white;border-bottom:1px solid #dde1e7}h1{font-size:21px;font-weight:600;margin:0 0 7px}p{line-height:1.55;margin:5px 0;color:#5e6571}.controls{display:flex;gap:9px;align-items:center;flex-wrap:wrap;margin-top:13px}input,select,button{font:inherit;border:1px solid #c8ced7;border-radius:6px;padding:8px 10px;background:white;color:#252a34}button{cursor:pointer}button:hover{background:#f0edf5}input{width:200px}main{display:grid;grid-template-columns:minmax(500px,1fr) 345px;gap:14px;padding:14px}section,aside{background:white;border:1px solid #e1e4e9;border-radius:9px}section{position:relative;min-height:650px}#plot{width:100%;height:680px;display:block;cursor:crosshair}aside{padding:18px;max-height:840px;overflow:auto}h2{font-size:23px;margin:0 0 7px;font-weight:600}h3{font-size:13px;margin:21px 0 9px;font-weight:600}.small{font-size:12px}.legend{padding:11px 18px;display:flex;gap:19px;flex-wrap:wrap;border-bottom:1px solid #eef0f3;font-size:12px}.swatch{display:inline-block;width:9px;height:9px;border-radius:50%;margin-right:6px}.tag{background:#f0edf5;color:#735080;border-radius:4px;padding:4px 7px;display:inline-block;font-size:12px;margin-right:4px}#hover{position:absolute;pointer-events:none;display:none;background:#fff;border:1px solid #cbd0d8;box-shadow:0 2px 9px #0002;padding:8px;border-radius:5px;font-size:12px;z-index:5}table{width:100%;border-collapse:collapse;font-size:12px}td,th{padding:4px 3px;border-bottom:1px solid #edf0f3;text-align:left}td:last-child,th:last-child{text-align:right;font-variant-numeric:tabular-nums}td button{padding:0;border:0;color:#426EA0;background:none;font-size:12px}details{margin-top:13px}summary{cursor:pointer;font-size:12px;color:#426EA0}#bars{width:100%;height:300px}footer{padding:0 25px 22px;font-size:12px;color:#68707d}#status{color:#795082}.keyhint{margin-left:auto;color:#68707d;font-size:12px}@media(max-width:900px){main{grid-template-columns:1fr}#plot{height:580px}aside{max-height:none}}
</style>
<header><h1>HT1080 candidate-profile UMAP</h1><p>Each point is a DepMap gene, represented by its signed correlations with <strong>56 HT1080 screen candidates</strong> (47 depleted, 9 enriched). Search or click a gene to inspect its profile.</p>
<div class="controls"><label for="search">Gene</label><input id="search" placeholder="e.g. KDM5C" value="KDM5C" list="suggestions"><datalist id="suggestions"></datalist><button id="find">Find</button>
<select id="mode" aria-label="Colour points"><option value="hits">HT1080 candidates</option><option value="biology">SAGA and X–Y gametologs</option><option value="coverage">DepMap model coverage</option></select>
<button id="minus" aria-label="Zoom out">−</button><button id="plus" aria-label="Zoom in">+</button><button id="reset">Reset view</button><span id="status" role="status"></span><span class="keyhint">Hover for names · Click to select · Scroll to zoom</span></div></header>
<main><section><div class="legend" id="legend"></div><canvas id="plot" aria-label="UMAP of 17,931 gene correlation profiles"></canvas><div id="hover"></div></section>
<aside><h2 id="gene"></h2><div id="tags"></div><p id="coverage" class="small"></p><h3>Distance to the SAGA profile</h3><p id="sagaDistance" class="small"></p><details><summary>Compare all 16 X-linked gametologs</summary><p class="small">Distance to the mean profile of all six SAGA hits: TAF6L, TADA2B, SUPT20H, TADA1, TAF5L and ATXN7L3. Smaller = closer. Computed in the original 56-feature space, not on this UMAP.</p><table id="sagaTable"></table></details><h3>Largest correlations in this gene’s profile</h3><canvas id="bars"></canvas><p class="small">Pearson r with individual HT1080 candidates. Self-comparisons are omitted.</p><details><summary>All 56 feature correlations</summary><table id="allcorr"></table></details>
<h3>Nearest profile matches</h3><p class="small">Ranked in the original 56-feature space, not by distance on this UMAP.</p><table id="neighbours"></table></aside></main>
<footer>DepMap Public 25Q3 · 17,931 eligible genes · original drugZ directional FDR &lt;0.25 candidate set. ZCCHC16 has no profile; 504 genes have fewer than 200 models. Unadjusted correlations use 316–1,186 models; Y-linked profiles are not restricted to Y-retaining models. UMAP: 30 neighbours, min_dist 0.3, seed 42. Local patterns are exploratory; the layout does not define significant clusters or establish LOY specificity. Full methods and source tables accompany the PDF.</footer>
<script>
const D=/*DATA_PAYLOAD*/;
const C={Depleted:'#795082',Enriched:'#00877C',SAGA:'#A88F25',X:'#426EA0',Y:'#C27B38',Other:'#CBD0D5'};
const $=id=>document.getElementById(id),canvas=$('plot'),ctx=canvas.getContext('2d'),bar=$('bars'),bc=bar.getContext('2d');
let selected=D.genes.indexOf('KDM5C'),zoom=1,cx=0,cy=0,width=0,height=0,scale=1,px=[],py=[];
const xs=D.xy.map(p=>p[0]),ys=D.xy.map(p=>p[1]),bounds=[Math.min(...xs),Math.max(...xs),Math.min(...ys),Math.max(...ys)];
const midx=(bounds[0]+bounds[1])/2,midy=(bounds[2]+bounds[3])/2;
function setup(c){let r=c.getBoundingClientRect(),d=devicePixelRatio||1;c.width=r.width*d;c.height=r.height*d;c.getContext('2d').setTransform(d,0,0,d,0,0);return [r.width,r.height]}
function colour(i){let mode=$('mode').value;if(mode==='hits')return C[D.directions[i]]||C.Other;if(mode==='biology')return C[D.gametolog[i]]||(D.saga[i]?C.SAGA:C.Other);let t=(D.n[i]-316)/(1186-316);return `rgb(${Math.round(224-170*t)},${Math.round(214-143*t)},${Math.round(231-102*t)})`}
function special(i){return $('mode').value==='hits'?D.directions[i]!=='Not nominated':$('mode').value==='biology'?(D.saga[i]||D.gametolog[i]):false}
function draw(){[width,height]=setup(canvas);ctx.clearRect(0,0,width,height);scale=Math.min((width-90)/(bounds[1]-bounds[0]),(height-90)/(bounds[3]-bounds[2]))*zoom;px=D.xy.map(p=>(p[0]-midx)*scale+width/2+cx);py=D.xy.map(p=>height/2-(p[1]-midy)*scale+cy);
for(let layer=0;layer<2;layer++){for(let i=0;i<D.genes.length;i++){let high=special(i);if((layer===1)!==Boolean(high)||px[i]<0||px[i]>width||py[i]<0||py[i]>height)continue;ctx.globalAlpha=high?.98:($('mode').value==='coverage'?.6:.38);ctx.fillStyle=colour(i);ctx.beginPath();ctx.arc(px[i],py[i],high?3.6:1.1,0,2*Math.PI);ctx.fill();if(high){ctx.lineWidth=.7;ctx.strokeStyle='white';ctx.stroke()}}}ctx.globalAlpha=1;
ctx.beginPath();ctx.arc(px[selected],py[selected],8,0,2*Math.PI);ctx.strokeStyle='#202633';ctx.lineWidth=1.8;ctx.stroke();ctx.font='600 13px Open Sans,Arial';let label=D.genes[selected],tw=ctx.measureText(label).width;ctx.fillStyle='#ffffffed';ctx.fillRect(px[selected]+11,py[selected]-17,tw+7,21);ctx.fillStyle='#202633';ctx.fillText(label,px[selected]+14,py[selected]-2);
ctx.font='12px Open Sans,Arial';ctx.fillStyle='#68707d';ctx.fillText('UMAP 1',width/2-23,height-10);ctx.save();ctx.translate(16,height/2+20);ctx.rotate(-Math.PI/2);ctx.fillText('UMAP 2',0,0);ctx.restore()}
function updateLegend(){let items=$('mode').value==='hits'?[['Depleted','LOY-depleted · 47'],['Enriched','LOY-enriched · 9'],['Other','Other genes']]:$('mode').value==='biology'?[['SAGA','SAGA'],['X','X-linked gametolog'],['Y','Y-linked gametolog']]:[];$('legend').innerHTML=items.length?items.map(([c,t])=>`<span><i class="swatch" style="background:${C[c]}"></i>${t}</span>`).join(''):'Lighter: 316 models &nbsp; → &nbsp; Darker: 1,186 models';}
function details(){let i=selected;$('gene').textContent=D.genes[i];let tags=[];if(D.directions[i]!=='Not nominated')tags.push('LOY-'+D.directions[i].toLowerCase());if(D.saga[i])tags.push('SAGA');if(D.gametolog[i])tags.push(D.gametolog[i]+'-linked gametolog');$('tags').innerHTML=tags.map(t=>`<span class="tag">${t}</span>`).join('');$('coverage').textContent=`${D.n[i].toLocaleString()} shared models · ${D.profiles[i].filter(v=>v!==null).length} non-self correlations`;
let sd=D.saga_distance.find(row=>row.gene===D.genes[i]);$('sagaDistance').textContent=sd?`All-six-hit centroid: ${sd.six_hit_distance.toFixed(3)} · rank ${sd.rank_X_six}/16 (includes ATXN7L3).`:'Select an X-linked gametolog, or expand the comparison table below.';$('sagaTable').innerHTML='<tr><th>X-linked gene</th><th>Distance</th></tr>'+D.saga_distance.map(row=>`<tr style="background:${row.gene===D.genes[i]?'#f0edf5':'transparent'}"><td><button data-index="${D.genes.indexOf(row.gene)}">${row.rank_X_six}. ${row.gene}</button></td><td>${row.six_hit_distance.toFixed(3)}</td></tr>`).join('');$('sagaTable').querySelectorAll('button').forEach(b=>b.onclick=()=>select(+b.dataset.index));
let pairs=D.features.map((g,j)=>[g,D.profiles[i][j]]);$('allcorr').innerHTML='<tr><th>HT1080 feature</th><th>Pearson r</th></tr>'+pairs.map(([g,r])=>`<tr><td>${g}</td><td>${r===null?'Self':r.toFixed(3)}</td></tr>`).join('');
$('neighbours').innerHTML='<tr><th>Gene</th><th>Profile distance</th></tr>'+D.neighbours[i].map((j,k)=>`<tr><td><button data-gene="${j}">${k+1}. ${D.genes[j]}</button></td><td>${D.distances[i][k].toFixed(3)}</td></tr>`).join('');$('neighbours').querySelectorAll('button').forEach(b=>b.onclick=()=>select(+b.dataset.gene));
let top=pairs.filter(p=>p[1]!==null).sort((a,b)=>Math.abs(b[1])-Math.abs(a[1])).slice(0,12);let [w,h]=setup(bar);bc.clearRect(0,0,w,h);let x0=173,bw=Math.max(35,(w-115)/2),limit=Math.max(.2,...top.map(p=>Math.abs(p[1])))*1.12;bc.font='11px Open Sans,Arial';bc.strokeStyle='#c9ced5';bc.beginPath();bc.moveTo(x0,0);bc.lineTo(x0,280);bc.stroke();top.forEach(([g,r],k)=>{let y=8+k*23;bc.fillStyle='#353c47';bc.textAlign='left';bc.fillText(g,0,y+10);let len=r/limit*bw;bc.fillStyle=r>=0?'#AA4B55':'#426EA0';bc.fillRect(Math.min(x0,x0+len),y,Math.abs(len),13);bc.fillStyle='#353c47';bc.textAlign=r>=0?'left':'right';bc.fillText(r.toFixed(2),x0+len+(r>=0?4:-4),y+11)});bc.textAlign='center';bc.fillStyle='#68707d';bc.fillText('Pearson r',x0,297)}
function select(i){selected=i;$('search').value=D.genes[i];$('status').textContent='';draw();details()}
function find(){let q=$('search').value.trim().toUpperCase(),i=D.genes.findIndex(g=>g.toUpperCase()===q);if(i<0){$('status').textContent='No eligible profile for this symbol';return}select(i)}
function nearest(ev){let r=canvas.getBoundingClientRect(),x=ev.clientX-r.left,y=ev.clientY-r.top,idx=-1,best=100;for(let i=0;i<px.length;i++){let d=(px[i]-x)**2+(py[i]-y)**2;if(d<best){best=d;idx=i}}return [idx,x,y]}
canvas.onmousemove=ev=>{let [i,x,y]=nearest(ev),tip=$('hover');if(i<0){tip.style.display='none';return}tip.textContent=`${D.genes[i]} · n=${D.n[i]}`;tip.style.display='block';tip.style.left=Math.min(x+15,width-180)+'px';tip.style.top=(y+55)+'px'};canvas.onmouseleave=()=>$('hover').style.display='none';canvas.onclick=ev=>{let [i]=nearest(ev);if(i>=0)select(i)};
canvas.addEventListener('wheel',ev=>{ev.preventDefault();let old=zoom;zoom=Math.max(.7,Math.min(8,zoom*(ev.deltaY<0?1.15:1/1.15)));let r=canvas.getBoundingClientRect(),x=ev.clientX-r.left-width/2,y=ev.clientY-r.top-height/2;cx=x-(x-cx)*zoom/old;cy=y-(y-cy)*zoom/old;draw()},{passive:false});
$('find').onclick=find;$('search').onkeydown=e=>{if(e.key==='Enter')find()};$('search').oninput=()=>{let q=$('search').value.toUpperCase();$('suggestions').innerHTML=D.genes.filter(g=>g.toUpperCase().startsWith(q)).slice(0,30).map(g=>`<option value="${g}">`).join('')};$('mode').onchange=()=>{updateLegend();draw()};$('plus').onclick=()=>{zoom=Math.min(8,zoom*1.3);draw()};$('minus').onclick=()=>{zoom=Math.max(.7,zoom/1.3);draw()};$('reset').onclick=()=>{zoom=1;cx=cy=0;draw()};window.onresize=()=>{draw();details()};updateLegend();draw();details();document.fonts.ready.then(()=>{draw();details()});
</script></html>
